# =============================================================================
# SafeEdge HazardGuard - Environment Configuration Template
# Copy this file to .env and configure for your local or cloud deployment.
# NEVER commit real credentials, passwords, or private API keys to version control.
# =============================================================================

# --- Streamlit Dashboard Configuration ---
# Public HTTPS URL of the deployed FastAPI backend (e.g. https://safeedge-backend.onrender.com)
SAFEEDGE_BACKEND_URL=http://localhost:8000
SAFEEDGE_DEVICE_ID=safeedge-esp32-01

# --- Backend Security & API Authentication ---
# Secret API key required by clients sending or retrieving telemetry
SAFEEDGE_API_KEY=your-safeedge-api-key-here
REQUIRE_API_KEY=true

# --- Database Storage Configuration ---
# Default SQLite local database file, or configure PostgreSQL for production
DATABASE_URL=sqlite:///safeedge_iot.db
# Production Managed PostgreSQL (Render, Neon, Supabase, or AWS RDS):
# DATABASE_URL=postgresql://safeedge_user:change_this_password@your-db-host.com:5432/safeedge_db

# --- Telemetry Freshness & Timeout (seconds) ---
# Telemetry older than this interval is flagged as stale in the cockpit
STALE_TIMEOUT_SECONDS=5.0

# --- MQTT Cloud Broker Settings ---
# Hostname and port of the MQTT broker (8883 for TLS, 1883 for plaintext)
MQTT_BROKER_HOST=broker.hivemq.com
MQTT_BROKER_PORT=8883
MQTT_USE_TLS=true
MQTT_USERNAME=your-mqtt-username-placeholder
MQTT_PASSWORD=your-mqtt-password-placeholder
MQTT_CLIENT_ID=safeedge-backend-service
MQTT_TOPIC_SUB=safeedge/devices/+/telemetry

# --- CORS Allowed Origins ---
# Comma-separated list of origins allowed to access the REST API
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501,https://*.streamlit.app
